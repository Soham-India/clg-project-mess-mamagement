# Copy to .env.local for local development. All are optional locally.

# Turso (hosted SQLite). Leave empty locally to use the file local.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Long random strings. Set these in production.
JWT_SECRET=change-me-to-a-long-random-string
CHECKIN_SECRET=change-me-to-another-long-random-string
